#!/usr/bin/env python3
"""Backend for the Surfshark Omarchy bar widget.

Surfshark's official Linux client is an Electron app with no CLI, but it does
not do the work itself: the tunnel is brought up by a helper daemon,
`surfsharkd`, which listens on a unix socket and speaks newline-delimited JSON.

    /run/user/<uid>/surfsharkd.sock     (mode 0666 — no root needed)

    {"method": "...", "params": [...]}\\n
    -> {"type":"result","value":...} | {"type":"error","value":{...}}

This backend talks to that same daemon. That is the whole design: no root, no
second tunnel, and no separate bookkeeping — the app and the widget always
agree, because they drive the same daemon.

Daemon methods (discovered by probing; they are not documented anywhere):

    getState()                              NetworkManager and tunnel state
    connect(kind)                           kind is "wg" or "openvpn"
    disconnect(kind)
    addConnection(kind, {domain, pub, priv})
    removeConnection(kind)
    version()

The server list, the "suggest" pick and the recent locations are read from the
app's own cache in ~/.config/Surfshark, so neither the network traffic nor the
selection logic is duplicated — "fastest" is the very server the app itself
would have chosen.

Every read here is bounded and every write is confined. Responses, the app's
cache and our own files are read through a hard byte cap checked before the
bytes are parsed; the config directory is reached by walking one component at a
time with `O_NOFOLLOW` and verified to be ours and private; and files are
written to a randomly named temporary created `O_EXCL | O_NOFOLLOW` at 0600,
then published with a descriptor-relative rename. This matters most for
`wg.key`, which holds the account's WireGuard private key.

Commands:
  status            JSON state (consumed by the widget)
  on                connect to the last used location, else the fastest
  off               tear the tunnel down
  fastest           Surfshark's own suggestion (same as its Quick Connect)
  nearest           geographically closest server abroad
  same              best server in the country you are currently in
  usa [host]        a United States exit (New York unless overridden)
  random            a random country
  connect <host>    a specific server, by connectionName
  recent [n]        recently used locations
  recent-clear      clear the recent list (and hide the app's own entries)
  recent-restore    undo the last recent-clear
  locations         JSON list of every location (used by the widget's search)
  list [filter]     plain-text server list from the app's cache
  key-import        copy the WireGuard key out of the app's NetworkManager profile
  state             raw getState() output, for debugging
"""

import errno
import json
import math
import os
import random
import secrets
import socket
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

UID = os.getuid()
HOME = os.path.expanduser("~")
SOCK = os.environ.get("SURFSHARKD_SOCK", "/run/user/%d/surfsharkd.sock" % UID)

# Directories as components rather than as strings to be re-walked: each one is
# opened a component at a time so no part of it can be swapped for a symlink.
APP_REL = (".config", "Surfshark")
CFG_REL = (".config", "omarchy-surfshark")
CFG_DISPLAY = os.path.join(HOME, *CFG_REL)

KEY_NAME = "wg.key"
RECENT_NAME = "recent.json"
RECENT_BAK_NAME = "recent.json.bak"
HIDDEN_NAME = "hidden.json"
CURRENT_NAME = "current"

GEO_URL = "https://api.surfshark.com/v1/server/user"
GEO_TTL = 300

# Caps. Each read is checked against one of these before anything is parsed.
# The app's own cache is the big one — a full server list is around 120 KB, so
# 16 MiB is far past anything real while still being a limit.
MAX_APP_JSON = 16 * 1024 * 1024
MAX_OWN_JSON = 1024 * 1024
MAX_KEY_BYTES = 4096
MAX_GEO_BYTES = 256 * 1024
MAX_RPC_BYTES = 4 * 1024 * 1024
CHUNK = 65536

# Default target for the "United States" shortcut. Overridable per call, so the
# widget can expose it as a setting rather than baking one city in for everyone.
USA_DEFAULT = "us-nyc.prod.surfshark.com"

# NetworkManager active-connection states:
# 1 = ACTIVATING, 2 = ACTIVATED, 3 = DEACTIVATING, 4 = DEACTIVATED.
NM_AC_ACTIVATING = 1
NM_AC_ACTIVATED = 2


class Unsafe(Exception):
    """A path or a response failed one of the checks below."""


def _die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------- safe file I/O

def _check_dir(fd, shown, own):
    """A directory descriptor is only usable if it is a directory, ours, and
    not writable by anyone else.

    `own` marks the one directory this plugin creates and maintains. That one is
    tightened in place — `os.makedirs(mode=...)` does nothing to a directory
    that already exists, so a mode set at creation time proves nothing later. A
    directory belonging to something else is reported rather than changed.
    """
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode):
        raise Unsafe("%s is not a directory" % shown)
    if st.st_uid != os.getuid():
        raise Unsafe("%s is not owned by you" % shown)
    if own:
        if st.st_mode & 0o077:
            os.fchmod(fd, 0o700)
    elif st.st_mode & 0o022:
        raise Unsafe("%s is writable by other users" % shown)


def _open_child_dir(parent_fd, name, shown, create, own):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    try:
        fd = os.open(name, flags, dir_fd=parent_fd)
    except FileNotFoundError:
        if not create:
            raise
        os.mkdir(name, 0o700, dir_fd=parent_fd)
        fd = os.open(name, flags, dir_fd=parent_fd)
    except OSError as e:
        # With O_DIRECTORY in the flags a symlink trips ENOTDIR rather than the
        # ELOOP a plain O_NOFOLLOW open would give, and ENOTDIR is equally
        # disqualifying when it means the component is a regular file.
        if e.errno in (errno.ELOOP, errno.ENOTDIR):
            raise Unsafe("%s is a symlink or not a directory" % shown)
        raise
    try:
        _check_dir(fd, shown, own)
    except BaseException:
        os.close(fd)
        raise
    return fd


def _open_dir(parts, create=False, own=False):
    """Open a directory under $HOME without ever following a symlink.

    The walk is anchored at the home directory and each component below it is
    opened `O_NOFOLLOW` from its parent's descriptor, so the path cannot be
    swapped underneath us between one component and the next. `own` applies to
    the last component only — the intermediate `.config` belongs to everything
    else on the system, not to us.

    The caller closes the returned descriptor.
    """
    fd = os.open(HOME, os.O_RDONLY | os.O_DIRECTORY)
    try:
        _check_dir(fd, HOME, False)
        shown = HOME
        for i, comp in enumerate(parts):
            shown = os.path.join(shown, comp)
            child = _open_child_dir(fd, comp, shown, create, own and i == len(parts) - 1)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def _read_file(dir_fd, name, limit):
    """A bounded, no-follow read of one regular file we own."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dir_fd)
    except OSError as e:
        if e.errno in (errno.ELOOP, errno.ENOTDIR):
            raise Unsafe("%s is a symlink" % name)
        raise
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise Unsafe("%s is not a regular file" % name)
        if st.st_uid != os.getuid():
            raise Unsafe("%s is not owned by you" % name)
        if st.st_size > limit:
            raise Unsafe("%s is larger than %d bytes" % (name, limit))
        buf = b""
        # One byte past the cap is read on purpose: a file that grew between the
        # fstat and the read is then caught rather than silently truncated.
        while len(buf) <= limit:
            chunk = os.read(fd, min(CHUNK, limit + 1 - len(buf)))
            if not chunk:
                break
            buf += chunk
        if len(buf) > limit:
            raise Unsafe("%s is larger than %d bytes" % (name, limit))
        return buf
    finally:
        os.close(fd)


def _write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def _write_private(dir_fd, name, data):
    """Publish a private file atomically, relative to a verified descriptor.

    The temporary name is random and created `O_EXCL | O_NOFOLLOW` at 0600, so
    it cannot collide with, or be pre-empted by, anything already sitting in the
    directory; the rename gives both ends as descriptors rather than as paths
    walked a second time. A symlink planted at the destination is replaced, not
    followed.
    """
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(8))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                 0o600, dir_fd=dir_fd)
    try:
        _write_all(fd, data)
        os.fsync(fd)
    except BaseException:
        os.close(fd)
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise
    os.close(fd)
    try:
        os.replace(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise


def cfg_dir(create=True):
    """Our own directory: created 0700, and tightened to 0700 if it is not."""
    return _open_dir(CFG_REL, create=create, own=True)


def _read_json_in(parts, name, limit, own=False):
    """Read one JSON file, or None if it is missing, oversized or not ours."""
    try:
        dir_fd = _open_dir(parts, create=False, own=own)
    except (OSError, Unsafe):
        return None
    try:
        return json.loads(_read_file(dir_fd, name, limit).decode("utf-8"))
    except (OSError, ValueError, Unsafe):
        return None
    finally:
        os.close(dir_fd)


def _read_text_in(dir_fd, name, limit):
    try:
        return _read_file(dir_fd, name, limit).decode("utf-8")
    except (OSError, ValueError, Unsafe):
        return None


# ------------------------------------------------------------------ daemon

def rpc(method, params=None, timeout=45):
    """One call per connection. The daemon closes the socket after answering."""
    if not os.path.exists(SOCK):
        raise RuntimeError("the Surfshark daemon is not running (no %s)" % SOCK)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps({"method": method, "params": params or []}) + "\n").encode())
        buf = b""
        # Bounded: a reply is one short JSON line, so anything that keeps coming
        # is a fault, and reading it to the end would be unbounded memory.
        while not buf.endswith(b"\n"):
            chunk = s.recv(min(CHUNK, MAX_RPC_BYTES + 1 - len(buf)))
            if not chunk:
                break
            buf += chunk
            if len(buf) > MAX_RPC_BYTES:
                raise RuntimeError("the daemon's answer to %s exceeded %d bytes"
                                   % (method, MAX_RPC_BYTES))
    finally:
        s.close()
    if not buf.strip():
        raise RuntimeError("the daemon did not answer %s" % method)
    msg = json.loads(buf.decode())
    if msg.get("type") == "error":
        v = msg.get("value") or {}
        raise RuntimeError(v.get("message") or v.get("name") or "daemon error")
    return msg.get("value")


def get_state():
    try:
        return rpc("getState") or {}
    except Exception:
        return {}


def tunnel_up(state):
    """Up if either backend is active or on its way up."""
    for k in ("wg_active_connection_state", "openvpn_active_connection_state"):
        if state.get(k) in (NM_AC_ACTIVATING, NM_AC_ACTIVATED):
            return True
    return False


# ------------------------------------------------------------- app's own data

def app_cache():
    return _read_json_in(APP_REL, "cache.json", MAX_APP_JSON) or {}


def app_settings():
    """Each account gets its own settings-<uuid>.json. `settings-undefined.json`
    is the pre-login template and is skipped on purpose."""
    try:
        dir_fd = _open_dir(APP_REL, create=False)
    except (OSError, Unsafe):
        return {}
    try:
        best = None
        for n in os.listdir(dir_fd):
            if not (n.startswith("settings-") and n.endswith(".json")):
                continue
            if n == "settings-undefined.json":
                continue
            try:
                st = os.stat(n, dir_fd=dir_fd, follow_symlinks=False)
            except OSError:
                continue
            if not stat.S_ISREG(st.st_mode):
                continue
            if best is None or st.st_mtime > best[0]:
                best = (st.st_mtime, n)
        if not best:
            return {}
        try:
            return json.loads(_read_file(dir_fd, best[1], MAX_APP_JSON).decode("utf-8")) or {}
        except (OSError, ValueError, Unsafe):
            return {}
    finally:
        os.close(dir_fd)


def _cache_value(cache, suffix):
    """Cache keys look like '<physical connection uuid>|<path>', or just
    '<path>'. Take the most recently refreshed entry ending in suffix."""
    best = None
    for k, v in cache.items():
        if not k.endswith(suffix) or not isinstance(v, dict):
            continue
        if best is None or v.get("updatedAt", 0) > best.get("updatedAt", 0):
            best = v
    return (best or {}).get("value")


def servers():
    s = _cache_value(app_cache(), "/v5/server/clusters/all")
    return s if isinstance(s, list) else []


def suggested(foreign=False):
    """Surfshark's own recommendation — what the app calls Quick Connect."""
    suffix = "/v5/server/suggest/foreign?limit=1" if foreign else "/v5/server/suggest?limit=1"
    v = _cache_value(app_cache(), suffix)
    if isinstance(v, list) and v:
        return v[0]
    return None


def generic(all_servers):
    """Ordinary exits only — no static-IP, multihop and similar entries, which
    are not what "fastest/nearest" should be offering."""
    return [s for s in all_servers
            if s.get("type") == "generic" and s.get("connectionName") and s.get("pubKey")]


# ---------------------------------------------------------------------- geo

class _SameHostRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect may not move the request to another host.

    Without this, whoever answers decides where the next request goes — and the
    answer is what the panel then shows as your public IP and country. Staying
    on the same host still allows the ordinary http -> https upgrade.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        old = urllib.parse.urlsplit(req.full_url)
        new = urllib.parse.urlsplit(newurl)
        if new.scheme not in ("http", "https") or new.hostname != old.hostname:
            raise urllib.error.HTTPError(
                req.full_url, code,
                "refusing to follow a redirect off %s" % (old.hostname or "the server"),
                headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


_OPENER = None


def _opener():
    global _OPENER
    if _OPENER is None:
        _OPENER = urllib.request.build_opener(_SameHostRedirect)
    return _OPENER


def _read_capped(resp, limit, what):
    """Read a response body, refusing anything past the cap.

    The declared length is checked first when there is one, but it is only a
    hint — the read itself is what enforces the limit.
    """
    declared = resp.headers.get("Content-Length")
    if declared and declared.isdigit() and int(declared) > limit:
        raise Unsafe("%s is larger than %d bytes" % (what, limit))
    buf = b""
    while len(buf) <= limit:
        chunk = resp.read(min(CHUNK, limit + 1 - len(buf)))
        if not chunk:
            break
        buf += chunk
    if len(buf) > limit:
        raise Unsafe("%s is larger than %d bytes" % (what, limit))
    return buf


_geo = {"at": 0, "data": None}


def geo():
    if _geo["data"] and time.time() - _geo["at"] < GEO_TTL:
        return _geo["data"]
    try:
        req = urllib.request.Request(GEO_URL, headers={"User-Agent": "omarchy-surfshark"})
        with _opener().open(req, timeout=8) as r:
            d = json.loads(_read_capped(r, MAX_GEO_BYTES, "the geo response").decode("utf-8"))
    except Exception:
        return _geo["data"] or {}
    if not isinstance(d, dict):
        return _geo["data"] or {}
    _geo["at"] = time.time()
    _geo["data"] = d
    return d


# ----------------------------------------------------------- picking a server

def coords(s):
    c = s.get("coordinates") or {}
    if c.get("latitude") is None or c.get("longitude") is None:
        return None
    return (c["latitude"], c["longitude"])


def haversine(a, b):
    lat1, lon1 = math.radians(a[0]), math.radians(a[1])
    lat2, lon2 = math.radians(b[0]), math.radians(b[1])
    h = (math.sin((lat2 - lat1) / 2) ** 2
         + math.cos(lat1) * math.cos(lat2) * math.sin((lon2 - lon1) / 2) ** 2)
    return 2 * 6371 * math.asin(math.sqrt(h))


def my_position(all_servers, g):
    """The geo endpoint returns a country and a city, not coordinates. As an
    approximate position, average the servers in our own country — accurate
    enough when the comparison is between countries rather than streets."""
    cc = (g or {}).get("countryCode")
    if not cc:
        return None
    pts = [coords(s) for s in all_servers if s.get("countryCode") == cc and coords(s)]
    if not pts:
        return None
    return (sum(p[0] for p in pts) / len(pts), sum(p[1] for p in pts) / len(pts))


def pick_fastest(all_servers, g):
    s = suggested()
    if s and s.get("pubKey"):
        return s
    # The suggestion cache is empty (the app has not fetched it yet) — fall back
    # to the least loaded server among the nearest. Home country is *not*
    # skipped here: "fastest" is allowed to be local.
    return pick_nearest(all_servers, g, by_load=True, foreign=False)


def pick_nearest(all_servers, g, by_load=False, foreign=True):
    """Closest server. Skips your own country by default: otherwise "Nearest
    country" returns exactly what "Same country" returns every time your country
    has a server, and two menu rows end up doing the same thing."""
    pool = generic(all_servers)
    cc = (g or {}).get("countryCode")
    if foreign and cc:
        without_home = [s for s in pool if s.get("countryCode") != cc]
        if without_home:
            pool = without_home
    pos = my_position(all_servers, g)
    withc = [s for s in pool if coords(s)]
    if not withc:
        return min(pool, key=lambda s: s.get("load", 100)) if pool else None
    if not pos:
        return min(withc, key=lambda s: s.get("load", 100))
    withc.sort(key=lambda s: haversine(pos, coords(s)))
    if by_load:
        return min(withc[:12], key=lambda s: s.get("load", 100))
    return withc[0]


def pick_same(all_servers, g):
    cc = (g or {}).get("countryCode")
    if not cc:
        return None
    pool = [s for s in generic(all_servers) if s.get("countryCode") == cc]
    if not pool:
        return None
    return min(pool, key=lambda s: s.get("load", 100))


def pick_usa(all_servers, preferred=None):
    """A US exit, preferring one specific city. If that city is missing from the
    cache, fall back to the least loaded US server rather than failing."""
    pool = [s for s in generic(all_servers) if s.get("countryCode") == "US"]
    if not pool:
        return None
    want = preferred or USA_DEFAULT
    for s in pool:
        if s.get("connectionName") == want:
            return s
    return min(pool, key=lambda s: s.get("load", 100))


def pick_random(all_servers, g):
    """A random country, then the least loaded server inside it.

    Country first, then server — not a server straight out of the pool. Picking
    a server directly would surface countries with twenty-odd exits (the US,
    Germany) far more often than one-exit countries, so "random country" would
    be random by server rather than by country, which is not the same thing.
    Your own country is skipped: staying home is not a change of location.
    """
    pool = generic(all_servers)
    cc = (g or {}).get("countryCode")
    by_country = {}
    for s in pool:
        code = s.get("countryCode")
        if not code or code == cc:
            continue
        by_country.setdefault(code, []).append(s)
    if not by_country:
        return None
    # Don't hand back the country you are already in, as long as there is a
    # choice — two clicks in a row should actually move you.
    here = current_host()
    if here:
        cur = find_host(all_servers, here)
        cur_cc = (cur or {}).get("countryCode")
        if cur_cc in by_country and len(by_country) > 1:
            del by_country[cur_cc]
    choice = random.choice(sorted(by_country))
    return min(by_country[choice], key=lambda s: s.get("load", 100))


def find_host(all_servers, host):
    for s in all_servers:
        if s.get("connectionName") == host:
            return s
    return None


# ------------------------------------------------------------- WireGuard key

def read_key():
    try:
        dir_fd = cfg_dir(create=False)
    except (OSError, Unsafe):
        return None
    try:
        k = _read_text_in(dir_fd, KEY_NAME, MAX_KEY_BYTES)
        return (k or "").strip() or None
    finally:
        os.close(dir_fd)


def store_key(k):
    """The account's private key. Written 0600 into a directory verified to be
    ours, through a temporary that cannot be pre-empted."""
    dir_fd = cfg_dir()
    try:
        _write_private(dir_fd, KEY_NAME, (k + "\n").encode("utf-8"))
    finally:
        os.close(dir_fd)


def key_from_nm():
    """On its first connection the app creates a NetworkManager WireGuard
    profile and writes the account's private key into it. We lift it out of
    there once, so that afterwards we can switch servers on our own."""
    try:
        out = subprocess.run(
            ["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"],
            capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return None
    names = [ln.rsplit(":", 1)[0] for ln in out.splitlines()
             if ln.endswith(":wireguard")]
    names = [n for n in names if "surfshark" in n.lower()] or names
    for n in names:
        try:
            p = subprocess.run(
                ["nmcli", "-s", "-g", "wireguard.private-key", "connection", "show", n],
                capture_output=True, text=True, timeout=10)
            k = p.stdout.strip()
            if k and k != "--":
                return k
        except Exception:
            continue
    return None


def require_key():
    k = read_key() or key_from_nm()
    if k:
        store_key(k)
        return k
    _die("No WireGuard key yet. Connect once through the Surfshark app, then "
         "run: omarchy-surfshark key-import", 7)


# ------------------------------------------------------------------- recents

def hidden():
    """Suppressed entries.

    "Clear" cannot simply drop our own list: half of it comes from the app's own
    `recents`, so the next status poll would bring the same entries straight
    back and the button would look broken. So whatever was on the list at the
    moment of clearing is remembered as hidden, until you connect there again.
    """
    v = _read_json_in(CFG_REL, HIDDEN_NAME, MAX_OWN_JSON, own=True)
    return set(v) if isinstance(v, list) else set()


def store_hidden(names):
    dir_fd = cfg_dir()
    try:
        _write_private(dir_fd, HIDDEN_NAME,
                       json.dumps(sorted(names), indent=1).encode("utf-8"))
    finally:
        os.close(dir_fd)


def own_recent():
    v = _read_json_in(CFG_REL, RECENT_NAME, MAX_OWN_JSON, own=True)
    return [i for i in v if isinstance(i, dict)] if isinstance(v, list) else []


def recent(limit=None):
    """Merge our own log with the app's `recents`, so the list is the same no
    matter where the connection was started from."""
    skip = hidden()
    mine = [i for i in own_recent() if i.get("connectionName") not in skip]
    items = list(mine)
    have = {i.get("connectionName") for i in items}
    all_servers = servers()
    for r in (app_settings().get("recents") or []):
        host = None
        if isinstance(r, dict):
            host = r.get("connectionName") or r.get("id") or r.get("target")
        elif isinstance(r, str):
            host = r
        if not host or host in have or host in skip:
            continue
        s = find_host(all_servers, host)
        if not s:
            continue
        have.add(host)
        items.append({
            "connectionName": host,
            "country": s.get("country", ""),
            "countryCode": s.get("countryCode", ""),
            "location": s.get("location", ""),
            "usedAt": 0,
        })
    items.sort(key=lambda i: i.get("usedAt", 0), reverse=True)
    return items[:limit] if limit else items


def push_recent(s):
    entry = {
        "connectionName": s["connectionName"],
        "country": s.get("country", ""),
        "countryCode": s.get("countryCode", ""),
        "location": s.get("location", ""),
        "usedAt": time.time(),
    }
    mine = [i for i in own_recent()
            if i.get("connectionName") != entry["connectionName"]]
    mine.insert(0, entry)
    was = hidden()
    if entry["connectionName"] in was:
        store_hidden(was - {entry["connectionName"]})
    dir_fd = cfg_dir()
    try:
        _write_private(dir_fd, RECENT_NAME,
                       json.dumps(mine[:10], indent=1).encode("utf-8"))
    finally:
        os.close(dir_fd)


def note_current(host):
    dir_fd = cfg_dir()
    try:
        _write_private(dir_fd, CURRENT_NAME, (host + "\n").encode("utf-8"))
    finally:
        os.close(dir_fd)


def current_host():
    try:
        dir_fd = cfg_dir(create=False)
    except (OSError, Unsafe):
        return None
    try:
        v = _read_text_in(dir_fd, CURRENT_NAME, MAX_KEY_BYTES)
        return (v or "").strip() or None
    finally:
        os.close(dir_fd)


# ---------------------------------------------------------------- connecting

def connect_to(s):
    if not s:
        _die("no matching server", 5)
    if not s.get("pubKey"):
        _die("server %s has no WireGuard key in the app's cache"
             % s.get("connectionName"), 5)
    priv = require_key()
    # The daemon will not edit a live profile in place: describe the new one
    # first, then activate it.
    rpc("addConnection", ["wg", {
        "domain": s["connectionName"],
        "pub": s["pubKey"],
        "priv": priv,
    }])
    rpc("connect", ["wg"])
    push_recent(s)
    note_current(s["connectionName"])
    print("%s · %s" % (s.get("location", "?"), s.get("country", "?")))


def disconnect_all():
    last = None
    ok = False
    for kind in ("wg", "openvpn"):
        try:
            rpc("disconnect", [kind])
            ok = True
        except Exception as e:
            last = e
    if not ok and last:
        _die(str(last), 4)
    print("disconnected")


def turn_on():
    """If a profile already exists, just activate it — that preserves whichever
    server the app set last, and needs no key at all."""
    r = recent(1)
    if r:
        s = find_host(servers(), r[0]["connectionName"])
        if s:
            connect_to(s)
            return
    try:
        rpc("connect", ["wg"])
        print("connected")
        return
    except Exception:
        pass
    connect_to(pick_fastest(servers(), geo()))


# ------------------------------------------------------------------ commands

def ensure_key_cached():
    """Copy the key out of the NM profile as soon as it is visible, on every
    status poll.

    NetworkManager only hands out `wireguard.private-key` while the profile the
    app created exists and is readable; after a disconnect it can disappear. If
    we relied on someone running the import by hand, the widget would fall back
    to "not set up" after every teardown. So status — which already runs every
    20 seconds — pins it to disk the first time it sees it.
    """
    if read_key():
        return True
    k = key_from_nm()
    if k:
        store_key(k)
        return True
    return False


def cmd_status():
    state = get_state()
    up = tunnel_up(state)
    g = geo()
    host = current_host()
    s = find_host(servers(), host) if host else None
    have_servers = bool(servers())
    out = {
        "daemon": os.path.exists(SOCK),
        "configured": ensure_key_cached() and have_servers,
        "connected": up,
        "endpoint": host if up else None,
        "location": (s or {}).get("location", "") if up else "",
        "country": (s or {}).get("country", "") if up else "",
        "countryCode": (s or {}).get("countryCode", "") if up else "",
        "load": (s or {}).get("load"),
        "ip": g.get("ip", ""),
        "secured": bool(g.get("secured")),
        "myCountry": g.get("country", ""),
        "myCountryCode": g.get("countryCode", ""),
        "myCity": g.get("city", ""),
        "recent": recent(5),
    }
    print(json.dumps(out, indent=1))


def cmd_recent_clear():
    # Set aside rather than delete. Clearing is one click with no confirmation,
    # so it must be undoable — see `recent-restore`.
    store_hidden({i["connectionName"] for i in recent()} | hidden())
    dir_fd = cfg_dir()
    try:
        os.replace(RECENT_NAME, RECENT_BAK_NAME, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except OSError:
        pass
    finally:
        os.close(dir_fd)
    print("recent list cleared (undo with: omarchy-surfshark recent-restore)")


def cmd_recent_restore():
    dir_fd = cfg_dir()
    try:
        try:
            os.replace(RECENT_BAK_NAME, RECENT_NAME, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
            restored = True
        except OSError:
            restored = False
        try:
            os.unlink(HIDDEN_NAME, dir_fd=dir_fd)
        except OSError:
            pass
    finally:
        os.close(dir_fd)
    print("recent list restored" if restored
          else "nothing set aside; un-hid the app's own entries")


def main():
    try:
        run(sys.argv[1:])
    except Unsafe as e:
        # The panel shows the last line of stderr, so a refused path should read
        # as a sentence rather than as the tail of a traceback.
        _die(str(e), 8)


def run(args):
    cmd = args[0] if args else "status"

    if cmd == "status":
        cmd_status()
    elif cmd == "off":
        disconnect_all()
    elif cmd == "on":
        turn_on()
    elif cmd == "fastest":
        connect_to(pick_fastest(servers(), geo()))
    elif cmd == "nearest":
        connect_to(pick_nearest(servers(), geo()))
    elif cmd == "same":
        g = geo()
        s = pick_same(servers(), g)
        if not s:
            _die("no Surfshark server in your country: %s" % g.get("country", "?"), 6)
        connect_to(s)
    elif cmd == "usa":
        s = pick_usa(servers(), args[1] if len(args) > 1 else None)
        if not s:
            _die("no US servers in the app's cache", 6)
        connect_to(s)
    elif cmd == "random":
        s = pick_random(servers(), geo())
        if not s:
            _die("nothing to pick a random country from", 6)
        connect_to(s)
    elif cmd == "connect":
        if len(args) < 2:
            _die("usage: omarchy-surfshark connect <connectionName>")
        s = find_host(servers(), args[1])
        if not s:
            _die("unknown server: %s" % args[1])
        connect_to(s)
    elif cmd == "locations":
        out = [{
            "connectionName": s["connectionName"],
            "country": s.get("country", ""),
            "countryCode": s.get("countryCode", ""),
            "location": s.get("location", ""),
            "load": s.get("load"),
        } for s in generic(servers())]
        out.sort(key=lambda i: (i["country"], i["location"]))
        print(json.dumps(out))
    elif cmd == "recent-clear":
        cmd_recent_clear()
    elif cmd == "recent-restore":
        cmd_recent_restore()
    elif cmd == "recent":
        n = int(args[1]) if len(args) > 1 else 10
        print(json.dumps(recent(n), indent=1))
    elif cmd == "list":
        filt = args[1].lower() if len(args) > 1 else ""
        for s in generic(servers()):
            line = "%-34s %-22s %-16s load=%s" % (
                s["connectionName"], s.get("country", ""), s.get("location", ""), s.get("load"))
            if not filt or filt in line.lower():
                print(line)
    elif cmd == "key-import":
        k = key_from_nm()
        if not k:
            _die("no WireGuard key found in any NetworkManager profile. Connect "
                 "once through the Surfshark app, then try again.", 7)
        store_key(k)
        print("key saved to %s" % os.path.join(CFG_DISPLAY, KEY_NAME))
    elif cmd == "state":
        print(json.dumps(get_state(), indent=1))
    else:
        _die(__doc__)


if __name__ == "__main__":
    main()
